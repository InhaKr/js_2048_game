// const Game = require('../modules/Game.class');
var game = new Game();
var cells = document.querySelectorAll(".field-cell"); // клеточки моего поля
var scoreDisplay = document.querySelector(".game-score"); // табло с очками
var startButton = document.querySelector(".button"); // start
var messageStart = document.querySelector(".message-start");
var messageWin = document.querySelector(".message-win");
var messageLose = document.querySelector(".message-lose");
function updateBoard() {
    var state = game.getState();
    cells.forEach(function(cell, index) {
        var row = Math.floor(index / 4); // строки
        var col = index % 4; // столбцы
        var value = state[row][col];
        cell.textContent = value === 0 ? "" : value;
        cell.className = "field-cell"; // Сбрасываем классы
        if (value !== 0) cell.classList.add("field-cell--".concat(value));
    });
    scoreDisplay.textContent = game.getScore();
}
function updateMessages() {
    var statusFunc = game.getStatus();
    messageStart.classList.add("hidden");
    messageWin.classList.add("hidden");
    messageLose.classList.add("hidden");
    if (statusFunc === "idle") {
        messageStart.classList.remove("hidden");
        startButton.textContent = "Start";
        startButton.classList.remove("restart");
        startButton.classList.add("start");
    } else if (statusFunc === "win") {
        messageWin.classList.remove("hidden");
        startButton.textContent = "Restart";
        startButton.classList.remove("start");
        startButton.classList.add("restart");
    } else if (statusFunc === "lose") {
        messageLose.classList.remove("hidden");
        startButton.textContent = "Restart";
        startButton.classList.remove("start");
        startButton.classList.add("restart");
    } else {
        startButton.textContent = "Restart";
        startButton.classList.remove("start");
        startButton.classList.add("restart");
    }
}
startButton.addEventListener("click", function() {
    if (game.getStatus() === "idle") game.start();
    else game.restart();
    updateBoard();
    updateMessages();
});
document.addEventListener("keydown", function(e) {
    if (game.getStatus() !== "playing") return;
    switch(e.key){
        case "ArrowLeft":
            game.moveLeft();
            break;
        case "ArrowRight":
            game.moveRight();
            break;
        case "ArrowUp":
            game.moveUp();
            break;
        case "ArrowDown":
            game.moveDown();
            break;
    }
    updateBoard();
    updateMessages();
});

